# Dependencias del proyecto (Node.js)
node_modules/

# Archivos generados por Expo y compilación web
.expo/
.expo-shared/
dist/
web-build/
expo-env.d.ts

# Carpetas nativas generadas al ejecutar Expo Prebuild
/android/
/ios/

# Archivos temporales de caché y compilación TypeScript
.cache/
.metro-health-check*
*.tsbuildinfo

# Variables de entorno y configuración local
.env
.env.local
.env.*.local

# Certificados, credenciales y llaves de firma
*.jks
*.keystore
*.p8
*.p12
*.key
*.mobileprovision

# Archivos de registro (logs) de gestores de paquetes
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
*.log

# Archivos ocultos del sistema operativo y configuración del IDE
.DS_Store
Thumbs.db
.idea/
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json

# Archivos temporales y respaldos de edición
*.orig.*
*.swp
*.swo
*~
